
:root {
    --bg: #0b1020;
    --panel: #121a30;
    --panel2: #18233e;
    --text: #eef3ff;
    --muted: #aab6d1;
    --accent: #71d6c4;
    --accent2: #8ca8ff;
    --line: rgba(255,255,255,.12);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: radial-gradient(circle at 85% 10%, #1a3150 0, transparent 30%), var(--bg);
    color: var(--text);
    line-height: 1.65;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(1080px, 90%);
    margin: auto;
}

header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(11,16,32,.9);
    border-bottom: 1px solid var(--line);
}

nav {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.brand {
    font-weight: 800;
}

.brand span,
h1 span {
    color: var(--accent);
}

.navlinks {
    display: flex;
    gap: 22px;
    color: var(--muted);
}

.navlinks a:hover {
    color: var(--accent);
}

.hero {
    padding: 100px 0 82px;
    display: grid;
    grid-template-columns: 1.4fr .8fr;
    gap: 50px;
    align-items: center;
}

.eyebrow {
    color: var(--accent);
    font-weight: bold;
    letter-spacing: 2px;
}

h1 {
    font-size: clamp(2.7rem, 7vw, 5rem);
    line-height: 1.05;
    margin: 16px 0;
}

.hero p {
    color: var(--muted);
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
}

.btn {
    display: inline-block;
    padding: 11px 19px;
    border-radius: 9px;
    font-weight: bold;
    border: 1px solid var(--accent);
}

.btn.primary {
    background: var(--accent);
    color: #08131c;
}

.btn.secondary {
    color: var(--text);
    border-color: var(--line);
}

.profile-card {
    background: linear-gradient(145deg, var(--panel2), var(--panel));
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 30px;
    text-align: center;
}

.avatar {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
    font-size: 2.6rem;
    font-weight: bold;
    color: #07131c;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
}

.profile-card p {
    font-size: .95rem;
    margin-top: 6px;
}

section {
    padding: 65px 0;
}

.section-title {
    font-size: 2rem;
    margin-bottom: 8px;
}

.section-sub {
    color: var(--muted);
    margin-bottom: 28px;
}

.about-box,
.card {
    background: rgba(18,26,48,.85);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.card h3 {
    margin-bottom: 8px;
}

.card p,
.about-box p {
    color: var(--muted);
}

.taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.tag {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent);
}

.project .number {
    color: var(--accent);
    font-size: .8rem;
    font-weight: bold;
}

.project ul {
    margin: 12px 0 0 20px;
    color: var(--muted);
}

.timeline {
    border-left: 2px solid var(--accent);
    padding-left: 22px;
    display: grid;
    gap: 22px;
}

.timeline-item {
    position: relative;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: -29px;
    top: 8px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
}

.timeline-item p {
    color: var(--muted);
}

.contact {
    text-align: center;
    background: linear-gradient(145deg, #14233c, #11192d);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 38px 24px;
}

.contact p {
    color: var(--muted);
    margin: 10px auto 20px;
}

footer {
    padding: 25px 0;
    text-align: center;
    color: var(--muted);
    border-top: 1px solid var(--line);
}

@media (max-width: 760px) {
    .hero {
        grid-template-columns: 1fr;
        padding-top: 70px;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    nav {
        align-items: flex-start;
        padding: 16px 0;
        flex-direction: column;
    }

    .navlinks {
        gap: 12px;
        flex-wrap: wrap;
        font-size: .85rem;
    }
}
